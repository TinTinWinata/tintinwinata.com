---
import Layout from "../layouts/Layout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline";
import { articles, awards, certifications, experiences, projects } from "../data/portfolio";

const title = "Justine Winata — Senior Software Engineer, AI Infrastructure";
const description = "Singapore-based senior software engineer building production AI infrastructure, distributed video systems and developer tools.";
---

<Layout title={title} description={description}>
  <main>
    <div class="reading-column">
      <header class="intro">
        <div>
          <p class="eyebrow">Senior Software Engineer · AI Infrastructure · Singapore</p>
          <h1>Justine Winata</h1>
          <p class="lede">I build production AI and distributed systems. At cynapse.ai, I built a video pipeline ingesting 16,000 frames per second from 2,000 cameras. I now work on natural-language search over 75 million detections and agents that investigate production incidents and propose fixes.</p>
          <nav class="contact-links" aria-label="Contact and profiles">
            <a href="mailto:tintin6892@gmail.com">email</a>
            <a href="https://github.com/TinTinWinata">github</a>
            <a href="https://www.linkedin.com/in/tintinwinata">linkedin</a>
            <a href="https://medium.com/@tintinwinata">medium</a>
            <a href="/Justine-Winata.pdf" download>résumé</a>
          </nav>
        </div>
      </header>

      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">What I’ve been doing</h2>
        <ExperienceTimeline experiences={experiences} client:load />
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading">Selected engineering work</h2>
        <div class="project-list">
          {projects.map((project) => (
            <article class="project">
              <div class="project-image-wrap">
                <img src={project.image} alt={project.imageAlt} loading="lazy" />
              </div>
              <div>
                <div class="project-heading">
                  <h3>{project.name}</h3>
                  <span>{project.dates}</span>
                </div>
                <p>{project.prose}</p>
                {project.siteUrl && <a class="inline-link" href={project.siteUrl}>{project.site} ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="writing-heading">
        <h2 id="writing-heading">Writing</h2>
        <p>I write here and on <a class="inline-link" href="https://medium.com/@tintinwinata">Medium</a> about systems I build and technologies I evaluate.</p>
        <div class="article-list">
          {articles.map((article) => (
            <a href={article.url}>
              <time>{article.date}</time>
              <span>{article.title}</span>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="recognition-heading">
        <h2 id="recognition-heading">Recognition</h2>
        <div class="award-list">
          {awards.slice(0, 3).map((award) => (
            <article>
              <strong>{award.place}</strong>
              <div>
                {award.url ? <a href={award.url}>{award.title} ↗</a> : <span>{award.title}</span>}
                <small>{award.org}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="certifications-heading">
        <h2 id="certifications-heading">Certifications</h2>
        <div class="certificate-list">
          {certifications.map((certificate) => (
            <a href={certificate.url}>
              <span class="certificate-icon"><img src={certificate.icon} alt={certificate.iconAlt} /></span>
              <time>{certificate.year}</time>
              <span class="certificate-copy">
                <span>{certificate.title}</span>
                <small>{certificate.org}</small>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="publications-heading">
        <h2 id="publications-heading">Publications</h2>
        <a class="publication-row" href="https://ieeexplore.ieee.org/document/10327087/">
          <time>2023</time>
          <span>
            <span>Analysis ChatGPT Potential: Transforming Software Development with AI Chat Bots</span>
            <small>IEEE Xplore</small>
          </span>
        </a>
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <p class="education-copy"><strong>B.Sc. in Computer Science</strong>, <a class="inline-link" href="https://binus.ac.id/">BINUS University</a> — GPA 3.92/4.00.</p>
      </section>

      <footer>
        <div>
          <h2>Let’s build reliable AI systems</h2>
          <p>Interested in AI infrastructure, distributed systems and developer tooling · Singapore</p>
        </div>
        <a class="email-button" href="mailto:tintin6892@gmail.com">email me</a>
      </footer>
    </div>
  </main>
</Layout>
